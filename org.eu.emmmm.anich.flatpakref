# Template for the file CI publishes next to the repository. It is filled in
# with the Pages URL and the base64 signing key and served as
# org.eu.emmmm.anich.flatpakref, which is the one command a user needs:
#
#   flatpak install --user https://<pages>/org.eu.emmmm.anich.flatpakref
#
# After that the app has a remote, so `flatpak update` (and the desktop's
# software centre) fetch new versions from it.
[Flatpak Ref]
Title=AniCh
Name=org.eu.emmmm.anich
Branch=master
Url=https://lyndon0na.github.io/AniCh-flatpak/repo
SuggestRemoteName=anich
Homepage=https://anich.emmmm.eu.org
Icon=https://lyndon0na.github.io/AniCh-flatpak/icon.png
IsRuntime=false
RuntimeRepo=https://dl.flathub.org/repo/flathub.flatpakrepo

